# Run backend commands from the repository root.
DATABASE_URL=sqlite:///./data/phishscope.db
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ALLOWED_HOSTS=127.0.0.1,localhost,backend

# Optional. Set keys here, restart backend, then check Settings.
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional frontend backend address. Default works for local execution.
BACKEND_URL=http://127.0.0.1:8000
